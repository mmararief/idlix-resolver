{
  "name": "idlix-resolver",
  "version": "1.0.0",
  "description": "High-performance stream and Indonesian subtitle extractor for IDLIX (z2.idlixku.com) powered by Pentos protocol automation and TLS browser impersonation.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "idlix-resolver": "./dist/cli.js",
    "idlix-tui": "./dist/tui.js",
    "idlix-api": "./dist/api.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/tui.js",
    "tui": "tsx src/tui.ts",
    "api": "tsx src/api.ts",
    "server": "tsx src/api.ts",
    "dev": "tsx src/index.ts",
    "test": "tsx example.ts",
    "cli": "tsx src/cli.ts"
  },
  "keywords": [
    "idlix",
    "stream-extractor",
    "m3u8-resolver",
    "indonesian-subtitles",
    "hls",
    "pentos",
    "majorplay",
    "video-scraper"
  ],
  "author": "Muhammad Ammar Arief",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmararief/idlix-resolver.git"
  },
  "bugs": {
    "url": "https://github.com/mmararief/idlix-resolver/issues"
  },
  "homepage": "https://github.com/mmararief/idlix-resolver#readme",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "impit": "^0.8.0",
    "open": "^11.0.4",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
